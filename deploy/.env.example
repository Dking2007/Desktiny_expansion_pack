DESKTINY_URL=http://host.docker.internal:8080
# Token and signing key of each plugin, from Quản trị › Plugin › Duyệt quyền (or Đổi khoá).
CHAM_CONG_TOKEN=
CHAM_CONG_SECRET=
LUONG_KPI_TOKEN=
LUONG_KPI_SECRET=
SO_VAN_BAN_TOKEN=
SO_VAN_BAN_SECRET=
KY_SO_TOKEN=
KY_SO_SECRET=
NHAC_HAN_TOKEN=
NHAC_HAN_SECRET=
TIEP_NHAN_TOKEN=
TIEP_NHAN_SECRET=
SO_VAN_BAN_DEN_TOKEN=
SO_VAN_BAN_DEN_SECRET=
CAM_BIEN_TOKEN=
CAM_BIEN_SECRET=
# 1 when the intake pages sit behind a reverse proxy that sets X-Forwarded-For.
TIEP_NHAN_TRUST_PROXY=
